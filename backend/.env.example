
# PostgreSQL and Redis are Railway managed services.
# Get connection strings from Railway dashboard → service → Connect tab.
# Do NOT use docker-compose or local containers for these.

# ── Core (required — server refuses to start if any is missing) ──
# Append ?connection_limit=10&pool_timeout=20 to the Railway-injected URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jobhuntpk?connection_limit=10&pool_timeout=20"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"
PORT="5000"

# ── Resume parser (separate Python service) ──
# Dev: http://localhost:8000   Prod: http://resume-parser.railway.internal:8000
RESUME_PARSER_URL="http://localhost:8000"
INTERNAL_SECRET="dev-internal-secret-change-me"
CRON_SECRET="dev-cron-secret-change-me"

# ── AI (Groq) ──
GROQ_API_KEY=""

# ── Email (Brevo SMTP) ──
BREVO_SMTP_USER=""
BREVO_SMTP_KEY=""

# ── File storage (Cloudflare R2) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ── Geocoding (Nominatim / OpenStreetMap) ──
NOMINATIM_USER_AGENT="JobHuntPK/1.0 contact@team.com"

# ── Job fetching ──
LOCAL_FETCH_DELAY_MS="2000"
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
FINDWORK_API_KEY=""
THEMUSE_API_KEY=""
JOOBLE_API_KEY=""
# JSearch via RapidAPI (free tier ~200 req/month). Leave blank to skip the source.
RAPIDAPI_KEY=""
