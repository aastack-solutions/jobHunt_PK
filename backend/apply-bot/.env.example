# apply-bot has NO public networking (same rule as resume-parser) — reachable only
# from the backend service. It never gets DATABASE_URL: it talks to Postgres only
# through the backend's authenticated /api/internal/apply-bot/* endpoints.

REDIS_URL="redis://localhost:6379"
BACKEND_URL="http://localhost:5000"
APPLY_BOT_SECRET="dev-apply-bot-secret-change-me"   # must match backend's APPLY_BOT_SECRET

PORT="8100"
NODE_ENV="development"

# Cloudflare R2 — same bucket/account as the backend, for the audit-trail screenshots
# (apply-bot/{userId}/{taskId}/{step}.jpg). Screenshot capture is skipped (not fatal)
# if these aren't set.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Phase 2 only (live-view WS server) — unused in Phase 1.
# LIVE_VIEW_ENABLED="false"
