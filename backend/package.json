{
  "name": "jobhuntpk-backend",
  "version": "0.1.0",
  "private": true,
  "description": "JobHunt PK backend — Express 5 API",
  "main": "src/app.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "test": "node -r dotenv/config --test",
    "test:coverage": "node -r dotenv/config --test --experimental-test-coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1073.0",
    "@aws-sdk/s3-request-presigner": "3.1073.0",
    "@json2csv/plainjs": "7.0.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "axios": "1.18.1",
    "bcrypt": "6.0.0",
    "bullmq": "5.79.1",
    "cheerio": "1.2.0",
    "compression": "1.8.1",
    "connect-redis": "9.0.0",
    "cookie": "0.7.2",
    "cookie-signature": "1.2.2",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "express-session": "1.19.0",
    "groq-sdk": "1.3.0",
    "helmet": "8.2.0",
    "multer": "2.2.0",
    "nodemailer": "9.0.1",
    "pg": "^8.22.0",
    "redis": "4.7.1",
    "rss-parser": "3.13.0",
    "winston": "3.19.0",
    "ws": "8.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "prisma": "7.8.0"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "bcrypt@6.0.0": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.8.0": true
