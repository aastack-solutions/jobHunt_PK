// JobHunt PK — Prisma schema
// 7 active tables: User, Resume, Job, JobMatch, Application, Interview, SchedulerLog.
// FlaggedJob (the 8th table) is reserved for a future week — do NOT add it here.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and the
// PrismaClient is constructed with a driver adapter (see src/db.js). The schema
// datasource block declares only the provider now.
datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  fullName           String
  timezone           String   @default("Asia/Karachi")

  // Salary expectations — raw value + currency, USD computed at match time.
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String   @default("USD") // "PKR" | "USD" — never omit

  // Job preferences.
  wantsRemote        Boolean  @default(true)
  wantsOnsiteKarachi Boolean  @default(false)

  // Home location — geocoded once when homeArea is saved.
  homeArea           String?
  homeLat            Float?
  homeLng            Float?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  resumes          Resume[]
  jobMatches       JobMatch[]
  applications     Application[]
  interviews       Interview[]
  applyCredentials ApplyCredential[]
  applyTasks       ApplyTask[]
  // emailIntegrations EmailIntegration[] // F14 — uncomment together with the
  // EmailIntegration model below when F14 is greenlit. Prisma requires the
  // reverse-relation field on both sides; uncommenting only the model (as its
  // own comment currently instructs) fails schema validation without this line.
}

model Resume {
  id              String   @id @default(cuid())
  userId          String
  fileName        String
  fileKey         String   // R2 object key
  skills          String[] @default([])
  experienceYears Int      @default(0)
  seniorityLevel  String   @default("junior")
  isImageBased    Boolean  @default(false)
  parseWarning    String?
  isActive        Boolean  @default(true)
  uploadedAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
  @@index([userId, isActive])
}

model Job {
  id             String   @id @default(cuid())
  externalId     String?  // id from source platform, for dedupe
  contentHash    String?  // sha1(company|title|desc[:200]) — content fingerprint for dedupe
  platform       String   // remotive | rozee | arbeitnow | mustakbil | himalayas ...
  title          String
  company        String
  description    String?

  locationType   String   // "Remote" | "Onsite" | "Hybrid" — location eligibility
  employmentType String?  // "full-time" | "contract" | "part-time" — employment terms
  city           String?  // normalized lowercase — "karachi" or null for Remote
  rawLocation    String?  // original string from source for debugging

  salaryMin      Int?     // raw value in original currency
  salaryMax      Int?     // raw value in original currency
  salaryCurrency String   @default("USD") // "PKR" | "USD"

  skills         String[] @default([])
  applyUrl       String

  isActive       Boolean  @default(true)
  fetchedAt      DateTime @default(now())
  postedAt       DateTime?
  expiresAt      DateTime // set in normalizeJob(), never null, no @default needed

  jobMatches   JobMatch[]
  applications Application[]
  applyTasks   ApplyTask[]

  // Dedupe enforced as DB constraints (spec §Job Fetching): exact source match
  // and content fingerprint. createMany({ skipDuplicates }) relies on these.
  @@unique([platform, externalId])
  @@unique([contentHash])
  @@index([isActive, locationType])
  @@index([isActive, expiresAt])
  @@index([isActive, fetchedAt])
}

model JobMatch {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  matchScore      Int
  locationType    String   // denormalized from Job — never join to get this
  matchedSkills   String[] @default([])
  skillScore      Int?
  experienceScore Int?
  salaryScore     Int?
  distanceKm      Float?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, matchScore])
  @@index([userId, locationType])
  @@index([jobId])
}

model Application {
  id           String   @id @default(cuid())
  userId       String
  jobId        String?
  jobTitle     String
  company      String
  locationType String   // denormalized from Job — never join to get this
  status       String   @default("applied")
  notes        String?
  applyUrl     String?  // resolved third-party form URL actually submitted to (apply-bot); null for manual entries
  source       String   @default("manual") // "manual" | "auto_apply_bot" — see docs/apply-bot/TECHNICAL_PLAN.md F13
  resumeId     String?  // which resume version was active/used at the time of this application
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  applyTasks ApplyTask[] // reverse of ApplyTask.applicationId — see that field's own comment

  @@index([userId, status])
  @@index([resumeId])
  @@index([userId, appliedAt])
  @@index([userId, locationType])
  @@index([jobId])
}

// Per-user, per-platform login the user pre-created (e.g. a Greenhouse/Lever account)
// so the apply-bot can log in and reuse their profile. Encrypted at rest — see
// backend/src/services/cryptoService.js for the AES-256-GCM scheme. username+password
// are encrypted together as one JSON payload (one iv/authTag pair per credential row).
model ApplyCredential {
  id                  String   @id @default(cuid())
  userId              String
  platform            String   // "greenhouse" | "lever" | "ashby" | "generic"
  loginUrl            String?  // for generic/custom logins
  credentialEncrypted Bytes    // AES-256-GCM ciphertext of JSON.stringify({ username, password })
  iv                  Bytes
  authTag             Bytes
  keyVersion          Int      @default(1)
  isActive            Boolean  @default(true)

  // Playwright storageState, saved after a successful login and reused on later
  // tasks so the bot doesn't have to re-authenticate (and re-trigger login CAPTCHAs)
  // on every run. Own iv/authTag pair — must NOT reuse the credential's above, GCM
  // requires the tag that was produced alongside its own ciphertext.
  sessionStateEncrypted Bytes?
  sessionStateIv        Bytes?
  sessionStateAuthTag   Bytes?
  sessionStateSavedAt   DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

// One row per attempted auto-application — the full audit trail for the apply-bot.
// Created by the selection step (backend/jobs/applyBotSelect.js), updated by the
// apply-bot worker's callback (POST /api/internal/apply-bot/callback).
model ApplyTask {
  id                String    @id @default(cuid())
  userId            String
  jobId             String?
  // Backfilled by internal.js's callback handler the moment a 'submitted' task
  // creates its Application row — see docs/apply-bot/TECHNICAL_PLAN.md F13. Fixed
  // 2026-08-17 (code review, F1 branch): originally had no DB-level FK or index
  // despite being documented as the audit-trail lookup key — an unindexed scan
  // waiting to happen the moment that lookup is actually used, and nothing stopped
  // it from pointing at a deleted Application. onDelete: SetNull, not Cascade — an
  // Application being deleted should not delete the bot's own audit trail of what
  // it did; the link just goes stale.
  applicationId     String?
  applyUrl          String
  adapterUsed       String    // "greenhouse" | "lever" | "ashby" | "generic"
  mode              String    // "shadow" | "live"
  status            String    @default("queued")
  // queued | running | paused_human | shadow_complete | submitted | failed
  // | skipped_low_confidence | skipped_duplicate | skipped_cap_reached | unknown_outcome
  // unknown_outcome: set ONLY by applyBotSweep.js when a task is stuck 'running' too
  // long (the apply-bot process likely crashed after possibly already submitting) —
  // deliberately excluded from applyBotSelect.js's auto-retry to avoid a duplicate
  // application; needs manual human resolution.
  // paused_human (F7, generalized from the original paused_captcha): a human hand-off
  // is in progress via the live-view — see pauseReason for which kind. Brought into
  // this branch 2026-08-17 from F7 to reconcile migration history: F7's branch had
  // already applied this column directly to the shared dev database independently
  // of this branch, causing Prisma migration drift when this branch's own fix
  // (applicationId's FK/index, below) tried to migrate — see MEMORY.md's
  // 2026-08-17 entry for the full story and the "one shared DB across many
  // branches" root cause.
  pauseReason       String?   // "captcha" | "email_verification" | "unknown_challenge" — set only while status is paused_human
  failureClass      String?   // CAPTCHA | EMAIL_VERIFICATION | AUTH | TIMEOUT | PORTAL_LAYOUT | NETWORK | LOW_CONFIDENCE | SSRF_BLOCKED | UNKNOWN
  fieldsFilled      Json?     // field name -> value actually typed; password-like fields redacted
  confidenceScore   Int?      // generic adapter only
  failureReason     String?
  screenshotKeys    String[]  @default([]) // R2 object keys, one per meaningful step
  captchaDetectedAt DateTime? // set when status first transitions to paused_human, any pauseReason
  captchaSolvedAt   DateTime? // set when a paused_human task resumes (human resolved it)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([jobId])
  @@index([status])
  @@index([applicationId])
}

